Options -Indexes

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "no-referrer"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
	<FilesMatch "\.(json|zip)$">
		Header always set Access-Control-Allow-Origin "*"
		Header always set Cache-Control "public, max-age=300, must-revalidate"
	</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
	AddType application/json .json
	AddType application/zip .zip
</IfModule>
