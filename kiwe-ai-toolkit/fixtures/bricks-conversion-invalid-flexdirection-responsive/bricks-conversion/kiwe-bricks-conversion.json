{
  "schema": "kiwe.bricks-conversion.v1",
  "source": {
    "html": "website/bricks-paste.html",
    "css": "pageSettings.customCss",
    "sourceHash": "fixture-flexdirection"
  },
  "target": {
    "builder": "bricks",
    "format": "bricks-elements-json",
    "mode": "conversion-review",
    "applyAuthority": "human-reviewed-kiwe-staging-adapter"
  },
  "conversion": {
    "converter": "ai-authored",
    "nativePreferred": true,
    "containsExecutableJs": false
  },
  "elements": [
    {
      "id": "head01",
      "name": "div",
      "parent": "0",
      "children": ["head02", "head03", "head04"],
      "settings": {
        "tag": "custom",
        "customTag": "section",
        "_cssId": "section-head",
        "_cssClasses": "seam-spread nc-section-head",
        "_attributes": [
          { "name": "data-flow", "value": "spread" }
        ],
        "_flexDirection:custom_phone": "column"
      }
    },
    {
      "id": "head02",
      "name": "text-basic",
      "parent": "head01",
      "children": [],
      "settings": {
        "tag": "span",
        "text": "Swipe by craving",
        "_cssClasses": "seam-eyebrow"
      }
    },
    {
      "id": "head03",
      "name": "heading",
      "parent": "head01",
      "children": [],
      "settings": {
        "tag": "h2",
        "text": "Chikki, the original."
      }
    },
    {
      "id": "head04",
      "name": "text-basic",
      "parent": "head01",
      "children": [],
      "settings": {
        "text": "The source keeps this section heading as a spread row at mobile.",
        "_cssClasses": "seam-summary"
      }
    }
  ],
  "pageSettings": {
    "customCss": ".nc-section-head{display:flex;justify-content:space-between;align-items:flex-start}"
  },
  "globalClasses": [],
  "globalVariables": [],
  "fidelity": {
    "sourceSelectors": [
      {
        "selector": "#section-head",
        "intent": "section heading spread",
        "mappedElementIds": ["head01"],
        "status": "mapped"
      }
    ],
    "elementMapping": [
      {
        "source": "section#section-head",
        "bricksElement": "div",
        "id": "head01"
      }
    ],
    "dynamicIntent": [],
    "responsiveIntent": [],
    "interactions": [],
    "conditions": [],
    "unsupported": []
  },
  "report": {
    "manualReview": [],
    "warnings": []
  }
}
