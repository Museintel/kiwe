{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiwe.dev/contracts/seam.geometry.v1.schema.json",
  "title": "SEAM page geometry inference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceHash", "solver", "viewports", "nodes", "summary", "limitations"],
  "properties": {
    "schema": { "const": "seam.geometry.v1" },
    "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "solver": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "SEAM Page Geometry Solver" }, "version": { "type": "string" } }
    },
    "viewports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "width", "height", "breakpoint"],
        "properties": { "id": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "breakpoint": { "type": ["string", "null"] } }
      }
    },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "widthMode", "layoutModel", "positionMode", "visibilityChanges", "responsiveChanges", "evidence"],
        "properties": {
          "id": { "type": "string" }, "widthMode": { "enum": ["intrinsic", "fixed", "fluid", "clamped", "unknown"] },
          "layoutModel": { "enum": ["block", "inline", "flex", "grid", "contents", "none", "other"] },
          "positionMode": { "enum": ["flow", "relative", "absolute", "fixed", "sticky", "other"] },
          "visibilityChanges": { "type": "boolean" },
          "responsiveChanges": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["viewportId", "breakpoint", "properties"],
              "properties": { "viewportId": { "type": "string" }, "breakpoint": { "type": ["string", "null"] }, "properties": { "type": "object", "additionalProperties": { "type": "string" } } }
            }
          },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["viewportId", "visible", "box"],
              "properties": {
                "viewportId": { "type": "string" }, "visible": { "type": "boolean" },
                "box": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } } }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "responsiveNodes", "visibilityChangingNodes", "widthModes"],
      "properties": {
        "nodes": { "type": "integer" }, "responsiveNodes": { "type": "integer" }, "visibilityChangingNodes": { "type": "integer" },
        "widthModes": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
